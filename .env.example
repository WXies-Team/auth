# 统一账号服务本地配置模板。复制成 .env 后填真实值；**密码与密钥绝不写进仓库**。

# 监听地址（默认 127.0.0.1:8868，对外一律走 nginx TLS 反代）
BIND_ADDR=127.0.0.1:8868

# MySQL 连接串（密码由运维生成，示例中的 PLACEHOLDER 需替换）
MYSQL_DSN=auth:PLACEHOLDER_PASSWORD@tcp(127.0.0.1:3306)/auth?charset=utf8mb4&parseTime=true&loc=Local

# JWT 签名密钥：至少 32 字节的随机串，不足拒启（运维生成，绝不写进仓库）
JWT_SECRET=PLACEHOLDER_MIN_32_BYTES_RANDOM_STRING_GOES_HERE

# 受信代理（逗号分隔 CIDR/IP；限流取真实客户端 IP 用，默认环回+内网，一般不用配）
# TRUSTED_PROXIES=127.0.0.0/8,192.168.0.0/16
